{
  "info": {
    "name": "Unified Employee & Department Services",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "employeeUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "departmentUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('adminToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"admin\",\"password\":\"admin123\"}"
            },
            "url": "{{employeeUrl}}/auth/token"
          }
        },
        {
          "name": "Get User Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('userToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"user\",\"password\":\"user123\"}"
            },
            "url": "{{employeeUrl}}/auth/token"
          }
        }
      ]
    },
    {
      "name": "Department Service (admin)",
      "item": [
        {
          "name": "Create Department",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Engineering\",\"location\":\"Pune\"}"
            },
            "url": "{{departmentUrl}}/api/departments"
          }
        },
        {
          "name": "List Departments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{departmentUrl}}/api/departments"
          }
        }
      ]
    },
    {
      "name": "Employee Service (admin)",
      "item": [
        {
          "name": "Create Employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Anita Patil\",\"email\":\"anita@example.com\",\"departmentId\":1}"
            },
            "url": "{{employeeUrl}}/api/employees"
          }
        },
        {
          "name": "List Employees",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{employeeUrl}}/api/employees"
          }
        },
        {
          "name": "Get Department Through Service A (RestClient)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{employeeUrl}}/api/employees/department/1"
          }
        }
      ]
    },
    {
      "name": "Authorization check (USER should receive 403)",
      "item": [
        {
          "name": "Attempt Create Department as User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Blocked\",\"location\":\"Mumbai\"}"
            },
            "url": "{{departmentUrl}}/api/departments"
          }
        }
      ]
    }
  ]
}